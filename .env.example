# Environment Variables for LeadScraper 2.0
# Copy this file to .env and fill in your actual values

# ============================================================
# REQUIRED: OpenRouter API Key (FREE!)
# ============================================================
# Sign up at https://openrouter.ai/ (free tier available)
# Go to https://openrouter.ai/keys to create an API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
# REQUIRED: Google Sheets Configuration
# ============================================================
# Create a Google Sheet and copy the ID from the URL:
# https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account JSON file
# See README.md for setup instructions
SERVICE_ACCOUNT_FILE=credentials/service_account.json
